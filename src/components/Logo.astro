<style>
	.glint {
		/* Start fully off the left edge; skewX(-22) is kept from the attribute */
		animation: glint-sweep 4s ease-in-out infinite alternate;
	}

	@keyframes glint-sweep {
		/* Rest at the left edge, sweep right, rest at the right edge.
		   `alternate` then plays this backwards for the return trip. */
		0%,
		20% {
			transform: translateX(-600px) skewX(-22deg);
		}
		80%,
		100% {
			transform: translateX(1626px) skewX(-22deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.glint {
			animation: none;
			opacity: 0;
		}
	}
</style>
