---
import Logo from './Logo.astro';
import Starfield from './Starfield.astro';
import VideoModal from './VideoModal.astro';
---

<div id="container" class="isolate bg-black">
	<Starfield class="-z-10" />

	<figure class="p-10 h-screen flex flex-col items-center justify-center">
		<Logo class="w-full max-w-200" />

		<h1 class="text-center mt-10 text-[#c82534] font-primary font-black text-xl sm:text-4xl">La historia de Star Wars<br> y sus coleccionables en el Perú</h1>
		<p class="text-[#c82534] mt-10">
			<button type="button" data-video-modal-open class="bg-white hover:opacity-80 transition-all text-black px-5 py-3 rounded-sm cursor-pointer font-secondary font-bold">Ver el teaser</button>
		</p>
	</figure>
	<VideoModal id="ZqdDCWhaX6k" title="Guerra de las Estrellas – teaser" />
</div>
