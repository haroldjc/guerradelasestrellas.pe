---
import Logo from './Logo.astro';
import Starfield from './Starfield.astro';
import VideoModal from './VideoModal.astro';
---

<div id="container" class="isolate bg-black">
	<Starfield class="-z-10" />

	<figure class="p-10 h-screen flex flex-col items-center justify-center">
		<Logo class="w-full max-w-200" />

		<h1 class="text-center mt-10 text-[#c82534] font-primary font-black text-xl sm:text-4xl">La historia de Star Wars<br> y sus coleccionables en el Perú</h1>
		<p class="text-[#c82534] mt-10">
			<button type="button" data-video-modal-open="v9CyEHpS3cc" class="bg-white hover:opacity-80 transition-all text-black px-5 py-3 rounded-sm cursor-pointer font-secondary font-bold">Ver el teaser</button>
		</p>
		<p class="mt-4">
			<button type="button" data-video-modal-open="yWMN_etA9s4" lang="en" class="font-secondary text-sm text-white/90 underline underline-offset-4 transition-colors hover:text-white/70 cursor-pointer">Watch in English</button>
		</p>
	</figure>
	<VideoModal id="v9CyEHpS3cc" title="Guerra de las Estrellas – teaser" />
	<VideoModal id="yWMN_etA9s4" title="Guerra de las Estrellas – teaser (English)" />
</div>
