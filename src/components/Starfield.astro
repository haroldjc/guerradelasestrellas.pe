---
interface Props {
	/** How many stars to draw. */
	count?: number;
	/** Fraction of stars that flicker, 0 to 1. */
	twinkleRatio?: number;
	/** Fraction of the flickering stars that blink sharply instead of fading. */
	sharpRatio?: number;
	/** Seed for the generator, so every build produces the same sky. */
	seed?: number;
	class?: string;
}

const {
	count = 300,
	twinkleRatio = 0.5,
	sharpRatio = 0.28,
	seed = 19770525,
	class: className,
} = Astro.props;

/** mulberry32: small, fast, deterministic PRNG. */
function mulberry32(a: number) {
	return () => {
		a |= 0;
		a = (a + 0x6d2b79f5) | 0;
		let t = Math.imul(a ^ (a >>> 15), 1 | a);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}

const VIEW_W = 1600;
const VIEW_H = 900;

/*
 * Two independent streams. `layout` draws exactly six values per star in a fixed
 * order, so the positions never move when flicker options are tuned. Anything
 * about how a star flickers comes from `flicker` instead.
 */
const layout = mulberry32(seed);
const flicker = mulberry32(seed + 0x9e3779b9);

const round = (n: number, places = 2) => Number(n.toFixed(places));

const stars = Array.from({ length: count }, () => {
	// Squaring biases the field toward many small, dim stars and a few bright ones.
	const depth = layout() ** 2;
	const cx = round(layout() * VIEW_W, 1);
	const cy = round(layout() * VIEW_H, 1);
	const twinkles = layout() < twinkleRatio;
	const speed = layout();
	// Negative, so stars start mid-cycle instead of all pulsing in unison.
	const delay = round(layout() * 8);

	const sharp = twinkles && flicker() < sharpRatio;
	// How far each star dips, so the field never breathes in lockstep.
	const dim = round(0.05 + flicker() * 0.35);

	return {
		cx,
		cy,
		r: round(0.5 + depth * 1.7),
		brightness: round(0.35 + depth * 0.6),
		twinkles,
		sharp,
		// Sharp blinks are brief, so they need a longer cycle to feel occasional.
		duration: sharp ? round(2.4 + speed * 3.4) : round(1.4 + speed * 2.8),
		delay,
		dim,
	};
});
---

<svg
	class:list={['pointer-events-none absolute inset-0 h-full w-full', className]}
	viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
	preserveAspectRatio="xMidYMid slice"
	aria-hidden="true"
>
	{
		stars.map((star) => (
			<circle
				cx={star.cx}
				cy={star.cy}
				r={star.r}
				fill="#fff"
				fill-opacity={star.brightness}
				class:list={[star.twinkles && 'twinkle', star.sharp && 'sharp']}
				style={
					star.twinkles
						? `--dim:${star.dim};animation-duration:${star.duration}s;animation-delay:-${star.delay}s`
						: undefined
				}
			/>
		))
	}
</svg>

<style>
	/*
	 * `opacity` multiplies with each star's static `fill-opacity`, so one keyframe
	 * dims every star relative to its own brightness. `--dim` varies per star.
	 */
	.twinkle {
		animation-name: twinkle;
		animation-iteration-count: infinite;
		animation-timing-function: ease-in-out;
	}

	/* A minority hold steady, then blink twice in quick succession. */
	.twinkle.sharp {
		animation-name: twinkle-sharp;
		animation-timing-function: ease-out;
	}

	@keyframes twinkle {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: var(--dim, 0.2);
		}
	}

	@keyframes twinkle-sharp {
		0%,
		55% {
			opacity: 1;
		}
		64% {
			opacity: var(--dim, 0.15);
		}
		73% {
			opacity: 1;
		}
		82% {
			opacity: var(--dim, 0.15);
		}
		91%,
		100% {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.twinkle {
			animation: none;
		}
	}
</style>
